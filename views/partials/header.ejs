<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sarpras Lab RPL & Elektronika' %></title>
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e40af',
              900: '#1e3a8a',
            }
          }
        }
      }
    }
  </script>
  
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
      }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

  <% if (typeof user !== 'undefined' && user) { %>
    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          
          <!-- Logo & Brand Title -->
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
              <i class="fa-solid fa-microchip text-lg"></i>
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <span class="font-extrabold text-slate-900 tracking-tight text-base sm:text-lg">SARPRAS LAB</span>
                <span class="text-xs px-2 py-0.5 rounded-full font-bold bg-blue-100 text-blue-800 border border-blue-200">RPL & ELEKTRONIKA</span>
              </div>
              <p class="text-xs text-slate-500 font-medium hidden sm:block">SMK Telkom — Manajemen Sirkulasi Peralatan Praktikum</p>
            </div>
          </div>

          <!-- User Role & Action -->
          <div class="flex items-center space-x-3 sm:space-x-4">
            
            <!-- Quick Role Badge -->
            <div class="hidden md:flex flex-col text-right">
              <span class="text-sm font-bold text-slate-800 leading-tight"><%= user.nama %></span>
              <span class="text-xs text-slate-500 font-mono">@<%= user.username %></span>
            </div>

            <!-- Dynamic Role Badge -->
            <% if (user.role === 'ADMIN') { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-purple-100 text-purple-800 border border-purple-200">
                <i class="fa-solid fa-shield-halved mr-1.5 text-purple-600"></i> ADMIN LAB
              </span>
            <% } else if (user.role === 'TOOLMAN') { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
                <i class="fa-solid fa-screwdriver-wrench mr-1.5 text-amber-600"></i> TOOLMAN / LABORAN
              </span>
            <% } else { %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                <i class="fa-solid fa-user-graduate mr-1.5 text-emerald-600"></i> PEMINJAM
              </span>
            <% } %>

            <!-- Logout Link -->
            <a href="/logout" title="Keluar dari sistem" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 transition-colors">
              <i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i> Logout
            </a>
          </div>

        </div>
      </div>

      <!-- Navigation Tabs (Role Based Access Navigation) -->
      <nav class="bg-slate-100/80 border-t border-slate-200/80 px-4 sm:px-6 lg:px-8 overflow-x-auto">
        <div class="max-w-7xl mx-auto flex space-x-1 sm:space-x-2 py-2">
          
          <!-- Menu: Dashboard (Semua Role) -->
          <a href="/dashboard" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'dashboard') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
            <i class="fa-solid fa-gauge-high mr-1.5"></i> Dashboard
          </a>

          <!-- Menu Khusus PEMINJAM (Siswa / Guru) -->
          <% if (user.role === 'PEMINJAM') { %>
            <a href="/catalog" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'catalog') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-boxes-stacked mr-1.5"></i> Katalog & Stok Alat
            </a>
            <a href="/borrowings" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'borrowings') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-handshake mr-1.5"></i> Peminjaman Saya
            </a>
          <% } %>

          <!-- Menu Khusus TOOLMAN (Laboran) -->
          <% if (user.role === 'TOOLMAN') { %>
            <a href="/borrowings" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'borrowings') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-clipboard-check mr-1.5"></i> Sirkulasi & Persetujuan
            </a>
            <a href="/catalog" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'catalog') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-boxes-stacked mr-1.5"></i> Ketersediaan Stok
            </a>
            <a href="/reports" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'reports') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-print mr-1.5"></i> Cetak Laporan
            </a>
          <% } %>

          <!-- Menu Khusus ADMIN (Kepala Lab IT) -->
          <% if (user.role === 'ADMIN') { %>
            <a href="/users" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'users') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-users-gear mr-1.5"></i> Data Pengguna
            </a>
            <a href="/categories" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'categories') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-tags mr-1.5"></i> Kategori Alat
            </a>
            <a href="/tools" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'tools') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-toolbox mr-1.5"></i> Inventaris Alat
            </a>
            <a href="/borrowings" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'borrowings') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-arrows-rotate mr-1.5"></i> Data Peminjaman
            </a>
            <a href="/reports" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'reports') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-file-invoice mr-1.5"></i> Laporan Sirkulasi
            </a>
            <a href="/logs" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all whitespace-nowrap <%= (typeof currentPage !== 'undefined' && currentPage === 'logs') ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 hover:text-slate-900 hover:bg-white' %>">
              <i class="fa-solid fa-clock-rotate-left mr-1.5"></i> Audit Log Lab
            </a>
          <% } %>

        </div>
      </nav>
    </header>
  <% } %>

  <!-- Main Container -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
