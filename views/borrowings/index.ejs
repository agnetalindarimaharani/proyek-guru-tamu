<%- include('../partials/header') %>

<div class="space-y-6">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
        <%= user.role === 'PEMINJAM' ? 'Daftar Peminjaman Saya' : 'Sirkulasi Peminjaman & Pengembalian Alat' %>
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        <%= user.role === 'PEMINJAM' ? 'Pantau status permohonan pinjam alat praktikum Anda dan konfirmasi penyerahan alat.' : 'Persetujuan peminjaman, monitoring alat di lapangan, inspeksi fisik pengembalian, dan penagihan denda sarpras.' %>
      </p>
    </div>

    <div class="flex items-center space-x-2 self-start sm:self-auto">
      <% if (user.role === 'PEMINJAM') { %>
        <button 
          type="button" 
          onclick="openModal('peminjamSubmitModal')"
          class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-600/20 transition-all inline-flex items-center space-x-2"
        >
          <i class="fa-solid fa-plus"></i>
          <span>Ajukan Pinjam Alat</span>
        </button>
      <% } else if (user.role === 'ADMIN') { %>
        <button 
          type="button" 
          onclick="openModal('adminAddModal')"
          class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-600/20 transition-all inline-flex items-center space-x-2"
        >
          <i class="fa-solid fa-plus"></i>
          <span>Input Transaksi Manual</span>
        </button>
      <% } %>
    </div>
  </div>

  <!-- Alerts -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm flex items-start space-x-2">
      <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5"></i>
      <span><%= success %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm flex items-start space-x-2">
      <i class="fa-solid fa-circle-exclamation text-rose-500 mt-0.5"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Search & Filter Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-3">
    <form action="/borrowings" method="GET" class="w-full md:w-auto flex-grow flex flex-col sm:flex-row gap-2">
      <div class="relative flex-grow max-w-md">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
        <input 
          type="text" 
          name="search" 
          value="<%= search %>" 
          placeholder="Cari peminjam, username, atau nama alat..." 
          class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
      </div>

      <select 
        name="status" 
        onchange="this.form.submit()" 
        class="py-2 px-3 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none font-semibold text-slate-700"
      >
        <option value="">Semua Status</option>
        <option value="PENDING" <%= filterStatus === 'PENDING' ? 'selected' : '' %>>PENDING (Menunggu)</option>
        <option value="APPROVED" <%= filterStatus === 'APPROVED' ? 'selected' : '' %>>APPROVED (Sedang Dipinjam)</option>
        <option value="RETURNED" <%= filterStatus === 'RETURNED' ? 'selected' : '' %>>RETURNED (Selesai Dikembalikan)</option>
        <option value="REJECTED" <%= filterStatus === 'REJECTED' ? 'selected' : '' %>>REJECTED (Ditolak)</option>
      </select>

      <select 
        name="toolId" 
        onchange="this.form.submit()" 
        class="py-2 px-3 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none font-semibold text-slate-700 max-w-xs"
      >
        <option value="">Semua Alat Lab</option>
        <% tools.forEach(t => { %>
          <option value="<%= t.id %>" <%= filterToolId == t.id ? 'selected' : '' %>>
            <%= t.namaAlat %>
          </option>
        <% }) %>
      </select>

      <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-bold transition-colors">
        Filter
      </button>
      <% if (search || filterStatus || filterToolId) { %>
        <a href="/borrowings" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-colors text-center">
          Reset
        </a>
      <% } %>
    </form>
    <div class="text-xs text-slate-500 whitespace-nowrap">
      Total: <strong class="text-slate-800"><%= borrowings.length %></strong> Transaksi
    </div>
  </div>

  <!-- Circulation Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">ID</th>
            <% if (user.role !== 'PEMINJAM') { %>
              <th class="py-3 px-4">Peminjam</th>
            <% } %>
            <th class="py-3 px-4">Alat & Kategori</th>
            <th class="py-3 px-4 text-center">Qty</th>
            <th class="py-3 px-4">Tanggal Pinjam</th>
            <th class="py-3 px-4">Rencana Kembali</th>
            <th class="py-3 px-4">Status & Fisik</th>
            <th class="py-3 px-4 text-right">Denda</th>
            <th class="py-3 px-4 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% if (borrowings.length === 0) { %>
            <tr>
              <td colspan="<%= user.role !== 'PEMINJAM' ? '9' : '8' %>" class="py-8 text-center text-slate-400">
                Tidak ada data peminjaman yang sesuai.
              </td>
            </tr>
          <% } else { %>
            <% borrowings.forEach(b => { %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="py-3 px-4 font-mono font-bold text-slate-400">
                  #<%= b.id %>
                </td>

                <% if (user.role !== 'PEMINJAM') { %>
                  <td class="py-3 px-4">
                    <p class="font-bold text-slate-900"><%= b.user.nama %></p>
                    <p class="text-[10px] text-slate-400 font-mono">@<%= b.user.username %> • NISN: <%= b.user.nisn || '-' %></p>
                  </td>
                <% } %>

                <td class="py-3 px-4">
                  <p class="font-bold text-slate-800"><%= b.tool.namaAlat %></p>
                  <p class="text-[10px] text-slate-400"><%= b.tool.category.namaKategori %></p>
                </td>

                <td class="py-3 px-4 text-center font-mono font-bold text-slate-800">
                  <%= b.jumlah %>
                </td>

                <td class="py-3 px-4">
                  <%= formatDate(b.tglPinjam) %>
                </td>

                <td class="py-3 px-4">
                  <span class="font-semibold text-slate-800"><%= formatDate(b.tglKembaliRencana) %></span>
                  <% if (b.tglKembaliReal) { %>
                    <p class="text-[10px] text-slate-400 font-mono">Real: <%= formatDate(b.tglKembaliReal) %></p>
                  <% } %>
                </td>

                <td class="py-3 px-4">
                  <% if (b.status === 'APPROVED') { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200">
                      <i class="fa-solid fa-circle-play mr-1 text-blue-600"></i> SEDANG DIPINJAM
                    </span>
                  <% } else if (b.status === 'PENDING') { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                      <i class="fa-solid fa-hourglass mr-1 text-amber-600"></i> MENUNGGU TOOLMAN
                    </span>
                  <% } else if (b.status === 'RETURNED') { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold <%= b.kondisiKembali === 'RUSAK' ? 'bg-rose-100 text-rose-800 border border-rose-200' : 'bg-emerald-100 text-emerald-800 border border-emerald-200' %>">
                      <i class="fa-solid fa-circle-check mr-1"></i> SELESAI (<%= b.kondisiKembali %>)
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                      <i class="fa-solid fa-circle-xmark mr-1"></i> DITOLAK
                    </span>
                  <% } %>
                  
                  <% if (b.catatan) { %>
                    <p class="text-[10px] text-slate-400 mt-0.5 truncate max-w-xs" title="<%= b.catatan %>">
                      <%= b.catatan %>
                    </p>
                  <% } %>
                </td>

                <td class="py-3 px-4 text-right font-mono font-bold <%= b.denda > 0 ? 'text-rose-600' : 'text-slate-400' %>">
                  <%= b.denda > 0 ? formatRupiah(b.denda) : 'Rp 0' %>
                </td>

                <td class="py-3 px-4 text-center">
                  <div class="flex items-center justify-center space-x-1.5">
                    
                    <!-- Aksi Khusus TOOLMAN (Fitur 7, 8, 9) -->
                    <% if (user.role === 'TOOLMAN') { %>
                      <% if (b.status === 'PENDING') { %>
                        <!-- Setujui Form -->
                        <form action="/borrowings/<%= b.id %>/approve" method="POST" onsubmit="return confirm('Setujui peminjaman <%= b.tool.namaAlat %>? Stok alat akan otomatis berkurang.');">
                          <button 
                            type="submit" 
                            class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-sm transition-colors"
                            <%= b.tool.stok < b.jumlah ? 'disabled title="Stok habis!"' : '' %>
                          >
                            Setujui
                          </button>
                        </form>

                        <!-- Tolak Button -->
                        <button 
                          type="button" 
                          onclick="openRejectModal(this)"
                          data-id="<%= b.id %>"
                          data-tool-name="<%= b.tool.namaAlat %>"
                          data-user-name="<%= b.user.nama %>"
                          class="px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold text-[11px] border border-rose-200 transition-colors"
                        >
                          Tolak
                        </button>
                      <% } else if (b.status === 'APPROVED') { %>
                        <!-- Terima & Inspeksi Pengembalian -->
                        <button 
                          type="button" 
                          onclick="openReturnInspectionModal(this)"
                          data-id="<%= b.id %>"
                          data-tool-name="<%= b.tool.namaAlat %>"
                          data-user-name="<%= b.user.nama %>"
                          data-qty="<%= b.jumlah %>"
                          class="px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-[11px] shadow-sm transition-colors"
                        >
                          Inspeksi Fisik & Kembali
                        </button>
                      <% } else { %>
                        <span class="text-[10px] text-slate-400 font-mono">Selesai</span>
                      <% } %>
                    <% } %>

                    <!-- Aksi Khusus PEMINJAM (Fitur 13: Kembalikan ke Meja Toolman) -->
                    <% if (user.role === 'PEMINJAM') { %>
                      <% if (b.status === 'APPROVED') { %>
                        <form action="/borrowings/<%= b.id %>/notify-return" method="POST" onsubmit="return confirm('Konfirmasi bahwa fisik alat sudah Anda serahkan di meja piket Toolman?');">
                          <button 
                            type="submit" 
                            class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-sm transition-colors"
                          >
                            <i class="fa-solid fa-arrow-turn-up mr-1"></i> Kembalikan ke Toolman
                          </button>
                        </form>
                      <% } else if (b.status === 'PENDING') { %>
                        <span class="text-[10px] text-amber-600 font-semibold italic">Dalam Antrean</span>
                      <% } else { %>
                        <span class="text-[10px] text-slate-400">Arsip</span>
                      <% } %>
                    <% } %>

                    <!-- Aksi Khusus ADMIN (CRUD Delete Transaksi) -->
                    <% if (user.role === 'ADMIN') { %>
                      <form action="/borrowings/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data sirkulasi ID <%= b.id %>?');">
                        <button 
                          type="submit" 
                          class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 flex items-center justify-center transition-colors"
                          title="Hapus Transaksi"
                        >
                          <i class="fa-solid fa-trash"></i>
                        </button>
                      </form>
                    <% } %>

                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal Peminjam: Ajukan Pinjam Alat (Fitur 12) -->
<div id="peminjamSubmitModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop bg-slate-900/50 backdrop-blur-sm items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-sm">
          <i class="fa-solid fa-clipboard-question"></i>
        </div>
        <h3 class="font-bold text-base text-slate-900">Form Pengajuan Peminjaman Alat</h3>
      </div>
      <button type="button" onclick="closeModal('peminjamSubmitModal')" class="text-slate-400 hover:text-slate-600">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/borrowings/submit" method="POST" class="space-y-3">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Pilih Alat Praktikum</label>
        <select name="toolId" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
          <option value="" disabled selected>-- Pilih Alat dari Lab --</option>
          <% tools.forEach(t => { %>
            <option value="<%= t.id %>" <%= t.stok === 0 || t.kondisi !== 'BAIK' ? 'disabled' : '' %>>
              <%= t.namaAlat %> (Stok: <%= t.stok %> unit <%= t.kondisi !== 'BAIK' ? '- RUSAK' : '' %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Jumlah Unit</label>
          <input type="number" name="jumlah" min="1" max="10" value="1" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-mono font-bold focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Target Pengembalian</label>
          <input type="date" name="tglKembaliRencana" id="submitModalDate" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Keperluan Praktikum / Kelas</label>
        <textarea name="catatan" rows="2" required placeholder="Contoh: Praktikum konfigurasi router dan crimping kabel UTP" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
      </div>

      <div class="flex justify-end space-x-2 pt-2">
        <button type="button" onclick="closeModal('peminjamSubmitModal')" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200">
          Batal
        </button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md shadow-blue-600/20">
          Kirim Pengajuan
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Admin: Input Transaksi Manual (Fitur 5) -->
<% if (user.role === 'ADMIN') { %>
  <div id="adminAddModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop bg-slate-900/50 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-sm">
            <i class="fa-solid fa-plus"></i>
          </div>
          <h3 class="font-bold text-base text-slate-900">Input Sirkulasi Peminjaman Langsung (Admin)</h3>
        </div>
        <button type="button" onclick="closeModal('adminAddModal')" class="text-slate-400 hover:text-slate-600">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form action="/borrowings/admin-create" method="POST" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Pilih Pengguna / Siswa</label>
          <select name="userId" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
            <% usersList.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.nama %> (@<%= u.username %> - <%= u.role %>)</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Pilih Alat Praktikum</label>
          <select name="toolId" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
            <% tools.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.namaAlat %> (Stok: <%= t.stok %> unit)</option>
            <% }) %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Jumlah</label>
            <input type="number" name="jumlah" min="1" value="1" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-mono font-bold focus:ring-2 focus:ring-blue-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Batas Kembali</label>
            <input type="date" name="tglKembaliRencana" id="adminModalDate" required class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Status Awal</label>
          <select name="status" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs font-bold focus:ring-2 focus:ring-blue-500 focus:outline-none">
            <option value="APPROVED">APPROVED (Langsung Disetujui / Potong Stok)</option>
            <option value="PENDING">PENDING (Menunggu Approval Toolman)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Catatan</label>
          <input type="text" name="catatan" placeholder="Contoh: Dipinjam untuk Uji Kompetensi Keahlian" class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div class="flex justify-end space-x-2 pt-2">
          <button type="button" onclick="closeModal('adminAddModal')" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200">
            Batal
          </button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md shadow-blue-600/20">
            Simpan Transaksi
          </button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<!-- Modal Toolman: Tolak Permohonan Pinjam -->
<div id="rejectModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop bg-slate-900/50 backdrop-blur-sm items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="font-bold text-base text-slate-900">Tolak Permohonan Pinjam</h3>
      <button type="button" onclick="closeModal('rejectModal')" class="text-slate-400 hover:text-slate-600">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="rejectForm" method="POST" class="space-y-4">
      <p class="text-xs text-slate-600">
        Tolak permohonan pinjam alat <strong id="rejectToolName" class="text-slate-900"></strong> oleh <strong id="rejectUserName" class="text-slate-900"></strong>.
      </p>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Alasan Penolakan</label>
        <textarea name="alasan" rows="3" required placeholder="Contoh: Alat sedang digunakan praktikum terjadwal lain." class="w-full p-3 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
      </div>

      <div class="flex justify-end space-x-2 pt-2">
        <button type="button" onclick="closeModal('rejectModal')" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200">
          Batal
        </button>
        <button type="submit" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-sm">
          Tolak Permohonan
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Toolman: Inspeksi Fisik & Input Denda Pengembalian (Test Case 5 & Fitur 8 & 9) -->
<div id="returnInspectionModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop bg-slate-900/50 backdrop-blur-sm items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-sm">
          <i class="fa-solid fa-microscope"></i>
        </div>
        <h3 class="font-bold text-base text-slate-900">Inspeksi Fisik & Terima Pengembalian</h3>
      </div>
      <button type="button" onclick="closeModal('returnInspectionModal')" class="text-slate-400 hover:text-slate-600">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="returnForm" method="POST" class="space-y-4">
      <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-xs space-y-1">
        <p><span class="text-slate-500">Nama Peminjam:</span> <strong id="returnUserName" class="text-slate-900"></strong></p>
        <p><span class="text-slate-500">Alat Praktikum:</span> <strong id="returnToolName" class="text-slate-900"></strong> (<span id="returnQty"></span> Unit)</p>
      </div>

      <!-- Pilihan Kondisi Fisik Alat -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Hasil Inspeksi Kondisi Fisik</label>
        <select 
          name="kondisiKembali" 
          id="kondisiKembaliSelect" 
          onchange="handleKondisiChange(this.value)"
          class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none font-bold"
        >
          <option value="BAIK">✅ BAIK (Kondisi utuh, bersih, dan normal)</option>
          <option value="RUSAK">⚠️ RUSAK (Cacat fisik, patah, port rusak, atau korsleting)</option>
          <option value="HILANG">❌ HILANG (Peralatan atau komponen tidak ada)</option>
        </select>
      </div>

      <!-- Input Nominal Denda -->
      <div id="dendaContainer" class="p-3 bg-rose-50/70 border border-rose-200 rounded-xl space-y-2">
        <label class="block text-xs font-bold text-rose-800 uppercase">
          Nominal Denda Kerusakan / Ganti Rugi (Rp)
        </label>
        <input 
          type="number" 
          name="denda" 
          id="dendaInput"
          min="0" 
          step="5000" 
          value="0" 
          class="w-full p-2.5 rounded-xl border border-rose-300 text-xs font-mono font-bold text-rose-900 focus:ring-2 focus:ring-rose-500 focus:outline-none bg-white"
        >
        <p class="text-[11px] text-rose-600">
          * Isi 0 jika kondisi BAIK. Isi nilai denda penggantian biaya servis/alat jika RUSAK atau HILANG.
        </p>
      </div>

      <!-- Catatan Inspeksi Detail -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Catatan Hasil Pemeriksaan Fisik</label>
        <textarea 
          name="catatanKondisi" 
          rows="2" 
          placeholder="Contoh: Kabel power utuh, port LAN berfungsi semua / ditemukan mata solder patah"
          class="w-full p-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
        ></textarea>
      </div>

      <div class="flex justify-end space-x-2 pt-2">
        <button type="button" onclick="closeModal('returnInspectionModal')" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200">
          Batal
        </button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md shadow-blue-600/20">
          Simpan Hasil Inspeksi & Kembalikan
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    const dateStr = tomorrow.toISOString().split('T')[0];
    
    const submitDate = document.getElementById('submitModalDate');
    if (submitDate) {
      submitDate.value = dateStr;
      submitDate.min = new Date().toISOString().split('T')[0];
    }

    const adminDate = document.getElementById('adminModalDate');
    if (adminDate) {
      adminDate.value = dateStr;
      adminDate.min = new Date().toISOString().split('T')[0];
    }
  });

  function openRejectModal(btn) {
    const id = btn.getAttribute('data-id');
    const toolName = btn.getAttribute('data-tool-name');
    const userName = btn.getAttribute('data-user-name');

    document.getElementById('rejectForm').action = '/borrowings/' + id + '/reject';
    document.getElementById('rejectToolName').innerText = toolName;
    document.getElementById('rejectUserName').innerText = userName;
    openModal('rejectModal');
  }

  function openReturnInspectionModal(btn) {
    const id = btn.getAttribute('data-id');
    const toolName = btn.getAttribute('data-tool-name');
    const userName = btn.getAttribute('data-user-name');
    const qty = btn.getAttribute('data-qty');

    document.getElementById('returnForm').action = '/borrowings/' + id + '/return';
    document.getElementById('returnToolName').innerText = toolName;
    document.getElementById('returnUserName').innerText = userName;
    document.getElementById('returnQty').innerText = qty;
    document.getElementById('kondisiKembaliSelect').value = 'BAIK';
    document.getElementById('dendaInput').value = '0';
    openModal('returnInspectionModal');
  }

  function handleKondisiChange(val) {
    const dendaInput = document.getElementById('dendaInput');
    if (val === 'RUSAK') {
      if (dendaInput.value === '0') dendaInput.value = '25000';
    } else if (val === 'HILANG') {
      if (dendaInput.value === '0') dendaInput.value = '100000';
    } else {
      dendaInput.value = '0';
    }
  }
</script>

<%- include('../partials/footer') %>
