<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #f8fafc;
      color: #0f172a;
    }

    @media print {
      body {
        background-color: white !important;
        color: black !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .print-container {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        border: none !important;
      }
      table {
        page-break-inside: auto;
      }
      tr {
        page-break-inside: avoid;
        page-break-after: auto;
      }
    }
  </style>
</head>
<body class="p-4 sm:p-8">

  <!-- Top Action Bar (No-Print) -->
  <div class="max-w-4xl mx-auto mb-6 flex items-center justify-between no-print">
    <a href="/reports" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-bold hover:bg-slate-50 transition-colors inline-flex items-center space-x-1.5">
      <i class="fa-solid fa-arrow-left"></i>
      <span>Kembali ke Laporan</span>
    </a>
    
    <button 
      type="button" 
      onclick="window.print()" 
      class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-md shadow-blue-600/30 transition-all inline-flex items-center space-x-2"
    >
      <i class="fa-solid fa-print"></i>
      <span>Cetak Dokumen Sekarang (PDF / Printer)</span>
    </button>
  </div>

  <!-- Document Paper Sheet Container -->
  <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg border border-slate-200 p-8 sm:p-12 print-container">
    
    <!-- Kop Surat Resmi Laboratorium -->
    <div class="border-b-2 border-slate-900 pb-4 mb-6">
      <div class="flex items-center justify-between">
        
        <!-- Logo / Icon -->
        <div class="w-16 h-16 rounded-xl bg-slate-900 text-white flex items-center justify-center text-3xl font-black">
          <i class="fa-solid fa-network-wired"></i>
        </div>

        <!-- Instansi Header -->
        <div class="text-center flex-grow px-4">
          <h2 class="text-xs font-bold uppercase tracking-widest text-slate-500">Yayasan Pendidikan Telkom</h2>
          <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight uppercase">SMK TELKOM LAMPUNG</h1>
          <p class="text-xs font-bold text-blue-700 uppercase tracking-wider">Laboratorium Rekayasa Perangkat Lunak & Elektronika</p>
          <p class="text-[10px] text-slate-500 mt-1">
            Jl. Raya Gadingrejo, Kab. Pringsewu, Lampung 35372 • Telp: (0729) 123456 • Email: lab.rpl@smktelkom-lpg.sch.id
          </p>
        </div>

        <div class="w-16 h-16 flex items-center justify-center text-slate-800 text-2xl font-black border-2 border-slate-900 rounded-xl">
          <i class="fa-solid fa-microchip"></i>
        </div>

      </div>
    </div>

    <!-- Document Title & Metadata -->
    <div class="text-center mb-6">
      <h2 class="text-base sm:text-lg font-extrabold uppercase tracking-wide text-slate-900 underline underline-offset-4">
        BERITA ACARA & LAPORAN SIRKULASI SARPRAS LAB
      </h2>
      <p class="text-xs text-slate-500 mt-1 font-mono">
        Nomor Dokumen: BA-LAB/RPL/<%= new Date().getFullYear() %>/<%= String(new Date().getMonth() + 1).padStart(2, '0') %>
      </p>
    </div>

    <!-- Info Parameter Laporan -->
    <div class="grid grid-cols-2 text-xs text-slate-700 mb-6 bg-slate-50 p-4 rounded-xl border border-slate-200">
      <div>
        <p><span class="text-slate-500">Periode Data:</span> <strong><%= filters.startDate ? formatDate(filters.startDate) : 'Awal' %> s/d <%= filters.endDate ? formatDate(filters.endDate) : 'Sekarang' %></strong></p>
        <p class="mt-1"><span class="text-slate-500">Filter Status:</span> <strong><%= filters.status %></strong></p>
      </div>
      <div class="text-right">
        <p><span class="text-slate-500">Tanggal Cetak:</span> <strong><%= formatDateTime(printDate) %></strong></p>
        <p class="mt-1"><span class="text-slate-500">Total Transaksi:</span> <strong><%= borrowings.length %> Peminjaman</strong></p>
      </div>
    </div>

    <!-- Circulation Data Table -->
    <div class="mb-6">
      <table class="w-full text-left text-xs border-collapse border border-slate-300">
        <thead>
          <tr class="bg-slate-100 text-slate-800 uppercase font-bold text-[10px]">
            <th class="border border-slate-300 py-2.5 px-3 text-center w-10">No.</th>
            <th class="border border-slate-300 py-2.5 px-3">Tgl Pinjam</th>
            <th class="border border-slate-300 py-2.5 px-3">Peminjam (Siswa/Guru)</th>
            <th class="border border-slate-300 py-2.5 px-3">Nama Alat Praktikum</th>
            <th class="border border-slate-300 py-2.5 px-3 text-center w-12">Qty</th>
            <th class="border border-slate-300 py-2.5 px-3">Kondisi Kembali</th>
            <th class="border border-slate-300 py-2.5 px-3 text-right">Denda (Rp)</th>
          </tr>
        </thead>
        <tbody>
          <% if (borrowings.length === 0) { %>
            <tr>
              <td colspan="7" class="border border-slate-300 py-6 text-center text-slate-400">
                Tidak ada data transaksi pada periode ini.
              </td>
            </tr>
          <% } else { %>
            <% borrowings.forEach((b, idx) => { %>
              <tr class="hover:bg-slate-50">
                <td class="border border-slate-300 py-2 px-3 text-center font-mono">
                  <%= idx + 1 %>
                </td>
                <td class="border border-slate-300 py-2 px-3 whitespace-nowrap">
                  <%= formatDate(b.tglPinjam) %>
                </td>
                <td class="border border-slate-300 py-2 px-3">
                  <span class="font-bold text-slate-900"><%= b.user.nama %></span>
                  <span class="block text-[10px] text-slate-500 font-mono"><%= b.user.role %> • <%= b.user.nisn || '-' %></span>
                </td>
                <td class="border border-slate-300 py-2 px-3">
                  <span class="font-semibold text-slate-800"><%= b.tool.namaAlat %></span>
                  <span class="block text-[10px] text-slate-400"><%= b.tool.category.namaKategori %></span>
                </td>
                <td class="border border-slate-300 py-2 px-3 text-center font-mono font-bold">
                  <%= b.jumlah %>
                </td>
                <td class="border border-slate-300 py-2 px-3">
                  <span class="font-semibold uppercase <%= b.kondisiKembali === 'RUSAK' ? 'text-rose-600 font-bold' : '' %>">
                    <%= b.status %> <%= b.kondisiKembali ? '• ' + b.kondisiKembali : '' %>
                  </span>
                </td>
                <td class="border border-slate-300 py-2 px-3 text-right font-mono font-bold <%= b.denda > 0 ? 'text-rose-600' : 'text-slate-500' %>">
                  <%= b.denda > 0 ? formatRupiah(b.denda) : '-' %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
        <tfoot>
          <tr class="bg-slate-100 font-bold text-slate-900">
            <td colspan="6" class="border border-slate-300 py-2.5 px-3 text-right uppercase text-[11px]">
              Total Penerimaan Kas Denda Kerusakan:
            </td>
            <td class="border border-slate-300 py-2.5 px-3 text-right font-mono text-xs text-rose-700">
              <%= formatRupiah(totalDenda) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Official Validation Signature Block -->
    <div class="mt-12 pt-6 border-t border-slate-200">
      <p class="text-xs text-slate-500 mb-8 text-right">
        Pringsewu, <%= formatDate(printDate) %>
      </p>

      <div class="grid grid-cols-2 gap-8 text-center text-xs">
        
        <!-- Left: Toolman / Laboran -->
        <div>
          <p class="text-slate-600 font-medium">Petugas Toolman / Laboran,</p>
          <div class="h-20 flex items-center justify-center">
            <!-- Digital signature stamp / blank space -->
            <span class="text-[10px] text-slate-300 italic">[Tanda Tangan & Cap]</span>
          </div>
          <p class="font-bold text-slate-900 uppercase underline">
            <%= toolman ? toolman.nama : 'Ahmad Rizky' %>
          </p>
          <p class="text-[10px] text-slate-500 font-mono">Toolman Lab Komputer</p>
        </div>

        <!-- Right: Kepala Lab Komputer -->
        <div>
          <p class="text-slate-600 font-medium">Mengetahui, Kepala Lab Komputer & IT,</p>
          <div class="h-20 flex items-center justify-center">
            <span class="text-[10px] text-slate-300 italic">[Tanda Tangan & Cap]</span>
          </div>
          <p class="font-bold text-slate-900 uppercase underline">
            <%= kepalaLab ? kepalaLab.nama : 'Budi Santoso, S.Kom' %>
          </p>
          <p class="text-[10px] text-slate-500 font-mono">NIP. 19850712 201001 1 008</p>
        </div>

      </div>
    </div>

  </div>

</body>
</html>
