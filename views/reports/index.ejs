<%- include('../partials/header') %>

<div class="space-y-6">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Laporan Sirkulasi Sarpras Laboratorium</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Rekapitulasi berkala peminjaman, pengembalian, dan kas denda kerusakan peralatan praktikum lab.</p>
    </div>

    <!-- Tombol Cetak Dokumen Resmi -->
    <a 
      href="/reports/print?startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>&status=<%= filters.status %>" 
      target="_blank"
      class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-600/20 transition-all inline-flex items-center space-x-2 self-start sm:self-auto"
    >
      <i class="fa-solid fa-print"></i>
      <span>Cetak Dokumen Resmi (PDF / Print)</span>
    </a>
  </div>

  <!-- Metric Statistics Summary -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
      <p class="text-xs font-bold text-slate-500 uppercase">Total Sirkulasi</p>
      <p class="text-2xl font-black text-slate-900 mt-1"><%= stats.totalTransaksi %></p>
      <span class="text-[11px] text-slate-400">Transaksi Terfilter</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
      <p class="text-xs font-bold text-slate-500 uppercase">Sedang Di Lapangan</p>
      <p class="text-2xl font-black text-blue-600 mt-1"><%= stats.totalAktif %></p>
      <span class="text-[11px] text-blue-600">Alat Sedang Dipinjam</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
      <p class="text-xs font-bold text-slate-500 uppercase">Telah Selesai</p>
      <p class="text-2xl font-black text-emerald-600 mt-1"><%= stats.totalSelesai %></p>
      <span class="text-[11px] text-emerald-600">Alat Kembali ke Lab</span>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
      <p class="text-xs font-bold text-slate-500 uppercase">Total Denda Terkumpul</p>
      <p class="text-2xl font-black text-rose-600 mt-1"><%= formatRupiah(stats.totalDenda) %></p>
      <span class="text-[11px] text-rose-600">Kas Penggantian Lab</span>
    </div>
  </div>

  <!-- Filter Form -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
    <form action="/reports" method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Dari Tanggal</label>
        <input 
          type="date" 
          name="startDate" 
          value="<%= filters.startDate %>" 
          class="w-full p-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Sampai Tanggal</label>
        <input 
          type="date" 
          name="endDate" 
          value="<%= filters.endDate %>" 
          class="w-full p-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Status Transaksi</label>
        <select 
          name="status" 
          class="w-full p-2 rounded-xl border border-slate-300 text-xs font-semibold focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
          <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>Semua Status</option>
          <option value="APPROVED" <%= filters.status === 'APPROVED' ? 'selected' : '' %>>APPROVED (Sedang Dipinjam)</option>
          <option value="RETURNED" <%= filters.status === 'RETURNED' ? 'selected' : '' %>>RETURNED (Selesai Dikembalikan)</option>
          <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>PENDING (Menunggu Persetujuan)</option>
        </select>
      </div>

      <div class="flex space-x-2">
        <button type="submit" class="w-full py-2 px-4 rounded-xl bg-slate-800 hover:bg-slate-900 text-white font-bold text-xs transition-colors">
          Terapkan Filter
        </button>
        <% if (filters.startDate || filters.endDate || filters.status !== 'ALL') { %>
          <a href="/reports" class="py-2 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition-colors flex items-center justify-center">
            Reset
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Preview Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-sm font-bold text-slate-900">Preview Data Laporan</h2>
      <span class="text-xs text-slate-400 font-mono"><%= borrowings.length %> Baris</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4">No.</th>
            <th class="py-3 px-4">Tanggal</th>
            <th class="py-3 px-4">Peminjam</th>
            <th class="py-3 px-4">Alat Praktikum</th>
            <th class="py-3 px-4 text-center">Jumlah</th>
            <th class="py-3 px-4">Status & Kondisi</th>
            <th class="py-3 px-4">Toolman PIC</th>
            <th class="py-3 px-4 text-right">Denda</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% if (borrowings.length === 0) { %>
            <tr>
              <td colspan="8" class="py-8 text-center text-slate-400">Tidak ada data sirkulasi pada rentang waktu ini.</td>
            </tr>
          <% } else { %>
            <% borrowings.forEach((item, index) => { %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="py-3 px-4 font-mono font-bold text-slate-400">
                  <%= index + 1 %>
                </td>
                <td class="py-3 px-4">
                  <%= formatDate(item.tglPinjam) %>
                </td>
                <td class="py-3 px-4">
                  <p class="font-bold text-slate-900"><%= item.user.nama %></p>
                  <p class="text-[10px] text-slate-400"><%= item.user.role %></p>
                </td>
                <td class="py-3 px-4">
                  <p class="font-bold text-slate-800"><%= item.tool.namaAlat %></p>
                  <p class="text-[10px] text-slate-400"><%= item.tool.category.namaKategori %></p>
                </td>
                <td class="py-3 px-4 text-center font-mono font-bold text-slate-800">
                  <%= item.jumlah %> Unit
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold <%= item.status === 'RETURNED' ? 'bg-emerald-100 text-emerald-800' : (item.status === 'APPROVED' ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800') %>">
                    <%= item.status %> <%= item.kondisiKembali ? '(' + item.kondisiKembali + ')' : '' %>
                  </span>
                </td>
                <td class="py-3 px-4">
                  <%= item.toolman ? item.toolman.nama : '-' %>
                </td>
                <td class="py-3 px-4 text-right font-mono font-bold <%= item.denda > 0 ? 'text-rose-600' : 'text-slate-400' %>">
                  <%= item.denda > 0 ? formatRupiah(item.denda) : 'Rp 0' %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
