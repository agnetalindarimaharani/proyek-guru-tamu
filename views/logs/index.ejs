<%- include('../partials/header') %>

<div class="space-y-6">
  
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Audit Log Aktifitas Sirkulasi Laboratorium</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">Rekam jejak digital audit setiap aksi sirkulasi: login, pengajuan pinjam, persetujuan toolman, inspeksi fisik, dan modifikasi master data.</p>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-3">
    <form action="/logs" method="GET" class="w-full md:w-auto flex-grow flex flex-col sm:flex-row gap-2">
      <div class="relative flex-grow max-w-md">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-xs"></i>
        <input 
          type="text" 
          name="search" 
          value="<%= search %>" 
          placeholder="Cari keterangan, nama user, atau username..." 
          class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"
        >
      </div>

      <select 
        name="aksi" 
        onchange="this.form.submit()" 
        class="py-2 px-3 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none font-semibold text-slate-700 font-mono"
      >
        <option value="ALL">Semua Jenis Aksi</option>
        <% distinctAksi.forEach(a => { %>
          <option value="<%= a %>" <%= filterAksi === a ? 'selected' : '' %>>
            <%= a %>
          </option>
        <% }) %>
      </select>

      <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl text-xs font-bold transition-colors">
        Filter
      </button>
      <% if (search || filterAksi !== 'ALL') { %>
        <a href="/logs" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-colors text-center">
          Reset
        </a>
      <% } %>
    </form>
    <div class="text-xs text-slate-500 whitespace-nowrap">
      Menampilkan <strong class="text-slate-800"><%= logs.length %></strong> Log Terakhir
    </div>
  </div>

  <!-- Activity Logs Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-50 text-slate-700 uppercase font-bold text-[10px] tracking-wider border-b border-slate-200">
          <tr>
            <th class="py-3 px-4 w-36">Waktu Kejadian</th>
            <th class="py-3 px-4 w-44">Pengguna (Aktor)</th>
            <th class="py-3 px-4 w-36">Aksi Sistem</th>
            <th class="py-3 px-4">Rincian Keterangan Aktivitas</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 font-medium">
          <% if (logs.length === 0) { %>
            <tr>
              <td colspan="4" class="py-8 text-center text-slate-400">Tidak ada log aktivitas yang cocok dengan kriteria.</td>
            </tr>
          <% } else { %>
            <% logs.forEach(log => { %>
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="py-3 px-4 font-mono text-[11px] text-slate-500 whitespace-nowrap">
                  <%= formatDateTime(log.createdAt) %>
                </td>
                <td class="py-3 px-4">
                  <% if (log.user) { %>
                    <p class="font-bold text-slate-900"><%= log.user.nama %></p>
                    <span class="inline-block text-[9px] font-mono font-bold px-1.5 py-0.2 rounded <%= log.user.role === 'ADMIN' ? 'bg-purple-100 text-purple-800' : (log.user.role === 'TOOLMAN' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800') %>">
                      <%= log.user.role %>
                    </span>
                  <% } else { %>
                    <span class="font-bold text-slate-400 font-mono">SYSTEM</span>
                  <% } %>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-block px-2 py-0.5 rounded font-mono font-bold text-[10px] <%= log.aksi.includes('RUSAK') ? 'bg-rose-100 text-rose-800' : (log.aksi.includes('SETUJUI') ? 'bg-emerald-100 text-emerald-800' : (log.aksi.includes('TOLAK') ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800')) %>">
                    <%= log.aksi %>
                  </span>
                </td>
                <td class="py-3 px-4 text-slate-700 leading-relaxed">
                  <%= log.keterangan %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
